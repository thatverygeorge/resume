---
import ButtonSavePdf from '@/components/ButtonSavePdf.astro';
import ThemeSwitcher from '@/components/ThemeSwitcher.astro';
---

<section>
  <ThemeSwitcher />
  <ButtonSavePdf />
</section>

<style>
  section {
    display: flex;
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
    flex-wrap: wrap;
    gap: 2rem;

    @media (width <= 960px) {
      justify-content: center;
    }

    @media print {
      display: none;
    }
  }
</style>
